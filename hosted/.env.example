SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-sb_secret-key
# Optional: set an access code if this deployment should be private.
# FRIDGEOPS_WEB_ACCESS_CODE=replace-with-private-demo-code
# Optional: otherwise the session signing key derives from SUPABASE_SECRET_KEY.
# FRIDGEOPS_SESSION_SECRET=replace-with-at-least-32-random-bytes
GEMINI_API_KEY=replace-with-your-private-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
